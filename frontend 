<form id="signup-form" method="POST" action="/signup">
  <input type="email" name="email" required />
  <div
    id="hcaptcha"
    class="h-captcha"
    data-sitekey="d2a034a6-03e6-4ef2-91d4-39dc9fbc5b1c"
    data-size="invisible"
    data-callback="onHCaptchaDone"
  ></div>
  <button id="submit-btn" type="button">Continue</button>
</form>
<style>
  .hcaptcha-overlay {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    width: 45px;
    height: 45px;
  }
  .hcaptcha-overlay-badge {
    cursor: pointer;
    border: 0;
    background: transparent;
    padding: 0;
  }
  .hcaptcha-overlay-badge img {
    width: 45px;
    height: auto;
    display: block;
  }
  .hcaptcha-overlay-popup {
    position: absolute;
    right: 53px;
    bottom: 0;
    width: 300px;
    min-height: 45px;
    box-sizing: border-box;
    opacity: 0;
    clip-path: inset(0 0 0 100%);
    pointer-events: none;
    background: #fff;
    border: 1px solid #ccc;
    padding: 10px;
    font-size: 12px;
    line-height: 1.4;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
    transform: translateX(8px);
    transition:
      clip-path 0.24s ease,
      opacity 0.18s ease,
      transform 0.24s ease;
  }
  .hcaptcha-overlay-popup.is-open {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
    transform: translateX(0);
  }
</style>
<div class="hcaptcha-overlay" id="hcaptcha-overlay">
  <button
    id="hcaptcha-badge"
    class="hcaptcha-overlay-badge"
    type="button"
    aria-label="hCaptcha disclosure"
  >
    <img src="data:image/svg+xml;base64," alt="Protected by hCaptcha" />
  </button>
  <div class="hcaptcha-overlay-popup" id="hcaptcha-popup">
    This site is protected by hCaptcha and its
    <a href="https://www.hcaptcha.com/privacy">Privacy Policy</a> and
    <a href="https://www.hcaptcha.com/terms">Terms of Service</a> apply.
  </div>
</div>
<script>
  function onHCaptchaDone() {
    document.getElementById("signup-form").submit();
  }
  document.getElementById("submit-btn").onclick = function () {
    hcaptcha.execute();
  };
  const overlay = document.getElementById("hcaptcha-overlay");
  const badge = document.getElementById("hcaptcha-badge");
  const popup = document.getElementById("hcaptcha-popup");
  let timeoutId;
  const openOverlay = () => {
    clearTimeout(timeoutId);
    popup.classList.add("is-open");
  };
  const closeOverlaySoon = () => {
    clearTimeout(timeoutId);
    timeoutId = setTimeout(() => popup.classList.remove("is-open"), 180);
  };
  overlay.addEventListener("mouseenter", openOverlay);
  overlay.addEventListener("mouseleave", closeOverlaySoon);
  popup.addEventListener("mouseenter", openOverlay);
  popup.addEventListener("mouseleave", closeOverlaySoon);
  badge.addEventListener(
    "touchstart",
    (event) => {
      event.preventDefault();
      popup.classList.toggle("is-open");
    },
    { passive: false },
  );
  popup.addEventListener("touchstart", openOverlay, { passive: true });
  document.addEventListener(
    "touchstart",
    (event) => {
      if (!overlay.contains(event.target)) {
        popup.classList.remove("is-open");
      }
    },
    { passive: true },
  );
</script>
<script src="https://js.hcaptcha.com/1/api.js" async defer></script>